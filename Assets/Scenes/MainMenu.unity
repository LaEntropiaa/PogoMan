  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreditsMenuController
  header: "POGO MAN\nUn peque\xF1o salto hacia el infierno."
  team:
  - role: Ideas y desarrollo creativo
    name: "Alonso Adri\xE1n Mart\xEDnez Hern\xE1ndez\nAlan Morales de la Cruz"
  - role: "Programaci\xF3n"
    name: "Alonso Adri\xE1n Mart\xEDnez Hern\xE1ndez\nAlan Morales de la Cruz"
  - role: Arte y modelado 3D
    name: "Rub\xE9n Jes\xFAs Garc\xEDa Torres"
  - role: "M\xFAsica y audio"
    name: Alan Morales de la Cruz
  - role: "Integraci\xF3n y producci\xF3n audiovisual"
    name: Alan Morales de la Cruz
  notes: "<color=#991208>M\xDASICA DEL MEN\xDA</color>\nTema de Steel Ball Run\n(JoJo's Bizarre Adventure)\n\n<color=#991208>M\xDASICA DEL JUEGO</color>\nDub Hub \u2014 Jimmy Fontanez\n\n<color=#991208>AGRADECIMIENTOS ESPECIALES</color>\nA quienes hicieron posible que una idea tan absurda como un hombre vendiendo su alma por un pogo se convirtiera en un videojuego.\n\nY a todos aquellos que se atrevan a saltar hasta las profundidades del infierno.\n\n<color=#731005>El infierno no acepta devoluciones.</color>\n\n\xB7 \xB7 \xB7\n\n<color=#731005>POGO MAN</color>\nDesarrollado en Unity \u2014 2026"
  roleColor: {r: 0.6, g: 0.07, b: 0.03, a: 1}
  highlightColor: {r: 0.45, g: 0.05, b: 0.02, a: 1}
  body: {fileID: 268146462}
  viewport: {fileID: 1593688422}
  autoScrollSpeed: 45
  startDelay: 1.2
  endPause: 2.5
  manualSpeed: 600
